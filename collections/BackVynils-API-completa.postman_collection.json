        { "name": "PUT actualizar", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Los Tigres (ed.)\",\n  \"image\": \"https://example.com/band.jpg\",\n  \"description\": \"Banda actualizada\",\n  \"creationDate\": \"1990-01-01T00:00:00.000Z\"\n}" }, "url": "{{baseUrl}}/bands/{{bandId}}" } },
