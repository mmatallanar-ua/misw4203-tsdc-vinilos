        { "name": "POST crear", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Excelente album\",\n  \"rating\": 5,\n  \"collector\": { \"id\": 100 }\n}" }, "url": "{{baseUrl}}/albums/{{albumId}}/comments" } },
        { "name": "PUT actualizar", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"description\": \"Comentario actualizado\",\n  \"rating\": 4,\n  \"collector\": { \"id\": 100 }\n}" }, "url": "{{baseUrl}}/albums/{{albumId}}/comments/{{commentId}}" } },
        { "name": "DELETE", "request": { "method": "DELETE", "url": "{{baseUrl}}/albums/{{albumId}}/comments/{{commentId}}" } }
