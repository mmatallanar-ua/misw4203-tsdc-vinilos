{
  "info": {
    "name": "BackVynils API (completa)",
    "description": "Colección completa de los 73 endpoints del backend. Variables: {{baseUrl}} (def. http://localhost:3000). POST devuelve 200, DELETE 204.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "albumId", "value": "100" },
    { "key": "bandId", "value": "101" },
    { "key": "musicianId", "value": "102" },
    { "key": "collectorId", "value": "100" },
    { "key": "prizeId", "value": "100" },
    { "key": "trackId", "value": "100" },
    { "key": "commentId", "value": "100" }
  ],
  "item": [
    {
      "name": "Albums",
      "item": [
        { "name": "GET listar", "request": { "method": "GET", "url": "{{baseUrl}}/albums" } },
        { "name": "GET uno", "request": { "method": "GET", "url": "{{baseUrl}}/albums/{{albumId}}" } },
        { "name": "POST crear", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Buscando America\",\n  \"cover\": \"https://example.com/cover.jpg\",\n  \"releaseDate\": \"1984-08-01T00:00:00.000Z\",\n  \"description\": \"Album de prueba\",\n  \"genre\": \"Salsa\",\n  \"recordLabel\": \"Elektra\"\n}" }, "url": "{{baseUrl}}/albums" } },
        { "name": "PUT actualizar", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Buscando America (ed.)\",\n  \"cover\": \"https://example.com/cover.jpg\",\n  \"releaseDate\": \"1984-08-01T00:00:00.000Z\",\n  \"description\": \"Album actualizado\",\n  \"genre\": \"Salsa\",\n  \"recordLabel\": \"Elektra\"\n}" }, "url": "{{baseUrl}}/albums/{{albumId}}" } },
        { "name": "DELETE", "request": { "method": "DELETE", "url": "{{baseUrl}}/albums/{{albumId}}" } }
      ]
    },
    {
      "name": "Bands",
